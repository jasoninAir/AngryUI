{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "server", "tests", "scripts"],
  "exclude": ["node_modules", "dist"]
}
